# ========================================
# 乡村振兴知识库搭建助手 - .gitignore
# 版本：v1.0.0
# 仓库类型：公开仓库（Public）
# ⚠️ 本文件是安全防线，阻止敏感文件上传到GitHub
# ========================================

# =============================================
# 🔴 第一优先级：绝对不能泄露的敏感文件
# =============================================

# API Key 加密配置（含加密后的密钥和加密种子）
config/settings.json
config/encryption.key
config/*.key
config/*.json

# 环境变量文件（可能包含明文密钥）
.env
.env.*
*.env

# =============================================
# 🟠 第二优先级：用户数据和知识库
# =============================================

# SQLite 数据库文件（你的全部知识库数据）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 用户原始资料文件夹
data/
data_backup/

# 备份和快照
backups/
snapshots/
*.bak
*.backup

# =============================================
# 🟡 第三优先级：运行时生成的文件
# =============================================

# Python 运行时缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# Python 嵌入式环境和虚拟环境
python-*/
python_embed/
venv/
.venv/
env/
ENV/

# 日志文件
logs/
*.log

# 临时文件
temp/
tmp/
*.tmp

# =============================================
# 🔵 第四优先级：开发和系统文件
# =============================================

# 打包/分发
build/
dist/
*.egg-info/
*.egg
*.spec
*.manifest
downloads/
wheels/

# 测试
.pytest_cache/
htmlcov/
.coverage
.tox/
.nox/

# 编辑器配置
.vscode/
.idea/
*.swp
*.swo
*~
.cursorignore
.cursorindexingignore

# Windows 系统文件
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
*.lnk

# macOS 系统文件（如果在Mac上操作过）
.DS_Store
.AppleDouble
.LSOverride
